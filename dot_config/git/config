[user]
	email = casey.tomlin@bayer.com
	name = caseytomlin
[pull]
	rebase = true
	ff = only
[fetch]
	prune = true
[rebase]
	autoStash = true
[rerere]
	enabled = 1
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	frag = magenta bold
	meta = yellow bold
	new = green bold
	old = red bold
	whitespace = red reverse
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[help]
	autoCorrect = immediate
[init]
	defaultBranch = main
[core]
	autocrlf = input
[commit]
	gpgsign = false
[push]
	autoSetupRemote = true
[alias]
	# Curated Oh My Zsh git-plugin shortcuts (shared across zsh + PowerShell)
	ga = add
	gaa = add --all
	gb = branch
	gc = commit
	gca = commit -a
	gcam = commit -a -m
	gco = checkout
	gcb = checkout -b
	gcm = !git checkout main 2>/dev/null || git checkout master
	gd = diff
	gds = diff --staged
	gf = fetch
	gl = pull
	gp = push
	gst = status
	gss = status -s
	glog = log --oneline --decorate --graph
