{{- if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = 'Continue'
Write-Host "Installing Windows tools via winget (idempotent)..."

function Refresh-SessionPath {
  $env:Path = [System.Environment]::GetEnvironmentVariable('Path', 'Machine') + ';' +
              [System.Environment]::GetEnvironmentVariable('Path', 'User')
  foreach ($p in @(
      "$env:ProgramFiles\nodejs",
      "${env:ProgramFiles(x86)}\nodejs",
      "$env:LOCALAPPDATA\Programs\nodejs",
      "$env:ProgramFiles\Git\cmd",
      "$env:LOCALAPPDATA\Programs\Git\cmd"
    )) {
    if ((Test-Path $p) -and ($env:Path -notlike "*$p*")) {
      $env:Path = "$p;$env:Path"
    }
  }
}

function Ensure-WingetPackage {
  param([string]$Id, [string]$Name = $Id)
  $found = winget list --id $Id -e 2>$null | Select-String -SimpleMatch $Id
  if ($found) {
    Write-Host "$Name already installed"
    return
  }
  Write-Host "Installing $Name ($Id)..."
  winget install --id $Id -e --accept-package-agreements --accept-source-agreements
}

if (Get-Command winget -ErrorAction SilentlyContinue) {
  Ensure-WingetPackage -Id 'Starship.Starship' -Name 'starship'
  Ensure-WingetPackage -Id 'jqlang.jq' -Name 'jq'
  Ensure-WingetPackage -Id 'astral-sh.uv' -Name 'uv'
  Ensure-WingetPackage -Id 'Amazon.AWSCLI' -Name 'aws'
  Ensure-WingetPackage -Id 'OpenJS.NodeJS.LTS' -Name 'node'
  Ensure-WingetPackage -Id 'junegunn.fzf' -Name 'fzf'
  Ensure-WingetPackage -Id 'Git.Git' -Name 'git'
  Ensure-WingetPackage -Id 'Atuinsh.Atuin' -Name 'atuin'
} else {
  Write-Host "warning: winget not available; skipping package installs"
}

Refresh-SessionPath

if (Get-Command npm -ErrorAction SilentlyContinue) {
  npm install -g --no-audit --no-fund --loglevel=error @anthropic-ai/claude-code 2>$null
  npm install -g --no-audit --no-fund --loglevel=error @musistudio/claude-code-router 2>$null
  if (Get-Command npx -ErrorAction SilentlyContinue) {
    Write-Host "Installing agent skills (mattpocock/skills)..."
    npx --yes skills add mattpocock/skills -g --all -y
  }
} else {
  Write-Host "warning: npm not available; skipping node global tools"
}

Write-Host "Windows tool bootstrap done."
{{- end -}}
