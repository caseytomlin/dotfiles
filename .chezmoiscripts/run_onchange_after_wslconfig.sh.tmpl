{{- /* Host-only: writes %USERPROFILE%\.wslconfig from WSL. Empty ⇒ skip on non-WSL. */ -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
#!/usr/bin/env bash
# Writes %USERPROFILE%\.wslconfig from WSL.
# WSL's default autoProxy=true injects Windows PAC proxies into every Linux
# process; that address is often unreachable from WSL and breaks Cursor
# extension installs, curl, MCP, etc. Proxy selection stays in ~/.proxy.sh.
set -euo pipefail

if ! command -v powershell.exe >/dev/null 2>&1; then
  echo "wslconfig: powershell.exe not available; skipping" >&2
  exit 0
fi

win_home="$(powershell.exe -NoProfile -NonInteractive -Command 'Write-Output $env:USERPROFILE' 2>/dev/null | tr -d '\r')"
if [ -z "${win_home}" ]; then
  echo "wslconfig: could not resolve Windows USERPROFILE; skipping" >&2
  exit 0
fi

if ! command -v wslpath >/dev/null 2>&1; then
  echo "wslconfig: wslpath not available; skipping" >&2
  exit 0
fi

dest="$(wslpath "${win_home}")/.wslconfig"

cat > "${dest}" <<'EOF'
[wsl2]
# WSL mirrors the Windows PAC-derived proxy into every Linux process
# (HTTP_PROXY / http_proxy / WSL_PAC_URL). Here that resolves to
# 163.116.128.80:80, which is only routable from Windows and never from WSL,
# so anything in WSL that honours the proxy env hangs until it times out
# (Cursor server extension downloads, curl, MCP).
# Proxy selection for WSL is handled per-shell by ~/.proxy.sh:
# prefer Windows px on 127.0.0.1:3128 (NTLM) when running, else DIRECT,
# else McAfee gateway (often 407 without Basic auth).
autoProxy=false

# Mirrored networking: WSL can reach Windows localhost (px on :3128).
# Requires Windows 11 22H2+; apply with: wsl --shutdown
# Start the bridge from WSL: px-bridge
# Or Windows PowerShell: Start-PxBridge
networkingMode=mirrored
dnsTunneling=true
EOF

echo "wslconfig: wrote ${dest}"
echo "wslconfig: from WSL start px with: px-bridge"
{{-   end -}}
{{- end -}}
